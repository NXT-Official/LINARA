# ========================================================================
# 1. LOCAL SECRETS & ENVIRONMENT VARIABLES (Security Critical)
# ========================================================================
.env
.env.local
.env.*
.dev.vars
*.pem
*.key
!.env.example

# ========================================================================
# 2. SYSTEM DEPENDENCIES & PACKAGE MANAGERS
# ========================================================================
node_modules/
/jspm_packages/
web_modules/
.npm
.eslintcache

# ========================================================================
# 3. COMPILATION & BUILD OUTPUTS (Nitro / Vite / Wrangler Pages / Edge Hosting)
# ========================================================================
.output/
dist/
build/
.next/
.nuxt/
.vercel/
.netlify/

# ========================================================================
# 4. COMPILER ENGINE & LOCAL EMULATION CACHES
# ========================================================================
.tanstack/
.vinxi/
.wrangler/
.turbo/
.cache/
.vite/
.nitro/
.parcel-cache
*.tsbuildinfo

# ========================================================================
# 5. TESTING & CODE QUALITY REPORTS
# ========================================================================
coverage/
playwright-report/
test-results/

# ========================================================================
# 6. IDE, EDITOR, & OPERATING SYSTEM JUNK
# ========================================================================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.DS_Store
Thumbs.db

# ========================================================================
# 7. TEMPORARY FILES & CACHED LOGS
# ========================================================================
tmp/
temp/
*.tmp
logs/

# Supabase CLI scratch state. supabase/.temp/linked-project.json records which
# project the CLI is pointed at, including the owner's email in the project
# name -- machine-local, and not something to commit.
supabase/.temp/

# Claude Code's per-machine permission allowlist. `.claude/settings.json` IS
# tracked (it is the shared project config); the `.local` one accumulates
# whatever a given machine happened to approve and belongs to nobody else.
.claude/settings.local.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
terminal_log.log
/feedback_local/*

# ========================================================================
# 8. LOCAL AI TOOL SETTINGS
# ========================================================================
.claude/settings.local.json

# Impeccable engine binary: platform-specific (~17 MB); the launcher downloads it on first run.
.claude/skills/impeccable/scripts/bin/
