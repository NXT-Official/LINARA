# The app currently reads no environment variables — it is a front-end-only
# prototype with all state in memory. Copy this file to `.env` when that changes.
#
# Client-exposed values MUST be prefixed with VITE_ (they ship in the browser bundle).
# VITE_APP_NAME=
#
# Server-only values MUST NOT use the VITE_ prefix (they stay in the SSR bundle).
# DATABASE_URL=
# API_SECRET=
