# Local development only. In production these values live in TWO separate
# places that never see each other: Vercel (the web app) and Supabase Edge
# Function secrets (supabase/functions/*). README.md section 12 says which
# variable goes where.

# --- Vercel (and local .env) ---------------------------------------------------
# Baked into the client bundle at build time via vite.config.ts `define`.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# "true" while no live AI provider is wired up; the server functions then
# return canned results instead of calling the edge functions.
USE_MOCK_AI=true
# Optional: absolute origin for link previews once a custom domain is live.
# SITE_URL=https://linara.example

# Read by server functions at request time (never bundled to the client).
REGIONAL_MINIMUM_WAGE=6000.00
# Needed only for real GCash/Maya payouts.
# Paying through Linara's own Xendit account is off: households pay the
# helper's GCash / Maya themselves and Linara records it (KNOWN_GAPS O35).
# XENDIT_PAYOUTS=on (read at build time, like USE_MOCK_AI) brings the "Pay via
# GCash / Maya" payout buttons back.
# XENDIT_PAYOUTS=
# XENDIT_SECRET_WRITE_KEY=xnd_development_...
# XENDIT_API_URL=https://api.xendit.co
# Push notifications to the helper app (src/features/notifications/push.ts).
# Optional: only needed once "Enhanced push security" is on for the Expo project.
# EXPO_ACCESS_TOKEN=your-expo-access-token

# --- Supabase Edge Function secrets (NOT read by this app) ----------------------
# Set with `npx supabase secrets set NAME=value`; listed here only so they are
# all in one place. See README.md section 12.3.
#   USE_MOCK_AI=true                      (a second, independent copy)
#   OPENAI_API_KEY=...                    (only once USE_MOCK_AI comes off)
#   SOP_CREATOR_MODEL / UTOS_ROUTER_MODEL / SOP_SIMPLIFIER_MODEL /
#   VOICE_PROMOTER_MODEL / TRANSCRIBE_MODEL  (optional model overrides)
#   XENDIT_WEBHOOK_VERIFICATION_TOKEN=... (xendit-payout-webhook)
