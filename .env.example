# Client-exposed values MUST be prefixed with VITE_ (if read by Vite in the browser bundle).
# Server-only/Edge function values MUST NOT use the VITE_ prefix.

# Supabase Local Configuration Coordinates (Run via Supabase CLI or point to live project)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Security & Secrets
JWT_SECRET=your_32_character_jwt_secret_here
SYSTEM_CRON_SECRET=your_system_cron_secret

# Regional Labor Parameters
REGIONAL_MINIMUM_WAGE=6000.00

# AI / LLM Orchestration (Phase 4 Edge Functions)
# e.g., OpenAI, Anthropic, or other target API keys deployed in Edge secrets
OPENAI_API_KEY=your-openai-api-key-here
# Model selection configuration for routing
SOP_CREATOR_MODEL=gpt-4o
UTOS_ROUTER_MODEL=gpt-4o-mini

# Offline/Mock Fallback controls for local prototype robustness
# Set to "true" to bypass Edge function and use client-side mock handlers
USE_MOCK_AI=true
